+    handover). Released right before the fly takes over. Not an autopilot.
+
+    Set and read back on ONE connection, retried for a few seconds. Sending
+    `set` + `quit` and closing at once let FlightGear drop the `set` (it can see the
+    close before the buffered command), so the separate read-back found the old value:
+    "Could not hold/release the parking brake" (2026-11-16, Linux, twice)."""
+    want = (str(int(on)), str(bool(on)).lower())
+    deadline = time.monotonic() + 5.0
+    while True:
+        try:
+            with socket.create_connection(('127.0.0.1', telnet_port), timeout=3) as s:
+                s.sendall(f'data\r\nset /controls/gear/brake-parking {int(on)}\r\n'
+                          'get /controls/gear/brake-parking\r\n'.encode())
+                reply, end = b'', time.monotonic() + 3
+                while b'\n' not in reply and time.monotonic() < end:
+                    chunk = s.recv(256)
+                    if not chunk:
+                        break
+                    reply += chunk
+                s.sendall(b'quit\r\n')
+            if reply.decode(errors='replace').strip() in want:
+                return True
+        except OSError:
+            pass
+        if time.monotonic() >= deadline:
+            return False
+        time.sleep(0.25)
 
 
