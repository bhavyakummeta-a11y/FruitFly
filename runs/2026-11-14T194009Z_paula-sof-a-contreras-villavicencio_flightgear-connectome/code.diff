diff --git a/flight_simulator/runway.py b/flight_simulator/runway.py
index da3cb7a..bc02f4c 100644
--- a/flight_simulator/runway.py
+++ b/flight_simulator/runway.py
@@ -130,7 +130,12 @@ class RunwaySim:
         ratio = (s.speed / 77.0) ** 2  # control power relative to rotation speed
 
         # Pitch axis: elevator (positive = nose down), alpha stability, damping.
-        pitch_acc = ratio * (0.6 * -c.elevator - 1.5 * (s.alpha - 0.04)) - 4.0 * s.pitch_rate
+        # Pitch, as fitted on FlightGear's 737 (KLAX connectome landing, 2026-11-14): elevator
+        # authority ~0.2, almost no natural pitch damping, response ~0.4 s late. The first
+        # model (0.6, damping 4.0, no lag) damped the plane itself and hid a pitch oscillation.
+        self.elevator_seen = getattr(self, 'elevator_seen', c.elevator)
+        self.elevator_seen += (c.elevator - self.elevator_seen) * min(1.0, dt / 0.4)
+        pitch_acc = ratio * (0.2 * -self.elevator_seen - 0.5 * (s.alpha - 0.04)) - 0.3 * s.pitch_rate
         if s.on_ground:
             pitch_acc -= 0.12  # weight on the nose gear
         s.pitch_rate += pitch_acc * dt
