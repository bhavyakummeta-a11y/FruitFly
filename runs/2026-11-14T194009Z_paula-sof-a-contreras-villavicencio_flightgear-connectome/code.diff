diff --git a/flight_simulator/flies.py b/flight_simulator/flies.py
index d11769e..166ce03 100644
--- a/flight_simulator/flies.py
+++ b/flight_simulator/flies.py
@@ -464,6 +464,15 @@ class LandingFly(PhaseFly):
             if s.agl < 100 * FT and not self.go_around:
                 flare = FLARE_GAIN * clip(r["DNp07"] / 20.0, 0, 1.6)
                 q_deg += flare
+                if flare > 0.3:
+                    self.flared = True
+                # Landing commitment (nerve cord): once the legs are out, a landing fly keeps
+                # them out. The flare checks the sink, the runway stops looming and DNp07 goes
+                # quiet; without this the nose dropped and the 737 fell from a 30 ft balloon
+                # (KLAX connectome landing, 2026-11-14: 1,176 fpm). No nose-down after the
+                # flare starts, except a little if the attitude is already high.
+                if getattr(self, 'flared', False):
+                    q_deg = max(q_deg, 0.0 if math.degrees(s.pitch) < 7.0 else -1.0)
                 # Fixed flare-envelope rule: leave margin below the model's 11-degree
                 # tail strike attitude, including momentum from the current pitch rate.
                 q_deg = min(q_deg, 2.0 * (9.0 - math.degrees(s.pitch))
