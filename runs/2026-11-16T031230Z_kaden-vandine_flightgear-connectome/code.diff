+class FakeTelnet:
+    """FlightGear telnet stand-in that drops the first `drop` sets, like fgfs did
+    when the client closed right after `set` (2026-11-16)."""
+    def __init__(self, drop):
+        import socket, threading
+        self.value, self.drop, self.connections = '0', drop, 0
+        self.server = socket.socket()
+        self.server.bind(('127.0.0.1', 0))
+        self.server.listen()
+        self.port = self.server.getsockname()[1]
+        threading.Thread(target=self.serve, daemon=True).start()
+
+    def serve(self):
+        while True:
+            try:
+                conn, _ = self.server.accept()
+            except OSError:
+                return
+            self.connections += 1
+            with conn:
+                buf = b''
+                while True:
+                    data = conn.recv(256)
+                    if not data:
+                        break
+                    buf += data
+                    while b'\r\n' in buf:
+                        line, buf = buf.split(b'\r\n', 1)
+                        words = line.decode().split()
+                        if words[:1] == ['set']:
+                            if self.drop:
+                                self.drop -= 1
+                            else:
+                                self.value = words[2]
+                        elif words[:1] == ['get']:
+                            conn.sendall(self.value.encode() + b'\r\n')
+                        elif words[:1] == ['quit']:
+                            break
+
+    def close(self):
+        self.server.close()
+
+
+class ParkingBrakeTests(unittest.TestCase):
+    def test_set_is_read_back_on_the_same_connection(self):
+        fg = FakeTelnet(drop=0)
+        self.addCleanup(fg.close)
+        self.assertTrue(takeoff_live.parking_brake(fg.port, True))
+        self.assertEqual(fg.value, '1')
+        self.assertEqual(fg.connections, 1)
+
+    def test_dropped_set_is_retried(self):
+        fg = FakeTelnet(drop=2)
+        self.addCleanup(fg.close)
+        self.assertTrue(takeoff_live.parking_brake(fg.port, True))
+        self.assertEqual(fg.value, '1')
+        self.assertEqual(fg.connections, 3)
+
+    def test_no_flightgear_fails_after_retrying(self):
+        import socket
+        s = socket.socket()
+        s.bind(('127.0.0.1', 0))
+        port = s.getsockname()[1]
+        s.close()  # nothing listens here
+        with mock.patch.object(takeoff_live.time, 'sleep'):
+            self.assertFalse(takeoff_live.parking_brake(port, False))
+
+
