+class GuardOffTheFlightLoop(unittest.TestCase):
+    """2026-11-16 Burbank crash: inline telnet polls (300-500 ms each, seconds when the sim
+    was busy) froze the flight loop for ~10 s on the approach. check() must not block,
+    and the rule must still be enforced from the background poll."""
+
+    def slow_fg(self, props, sticky=(), delay=0.4):
+        fg = FakeFG(props, sticky)
+        self.addCleanup(fg.server_close)
+        self.addCleanup(fg.shutdown)
+        real = FakeFG.Handler.handle
+
+        class Slow(FakeFG.Handler):
+            def handle(self):
+                import time
+                self.wfile.flush = (lambda f: (lambda: (time.sleep(delay), f())))(self.wfile.flush)
+                orig_write = self.wfile.write
+                def write(b):
+                    time.sleep(delay)
+                    return orig_write(b)
+                self.wfile.write = write
+                real(self)
+        fg.RequestHandlerClass = Slow
+        return fg
+
+    def test_check_does_not_block_on_slow_telnet(self):
+        import time
+        fg = self.slow_fg({'/autopilot/internal/CMDA': '0'})
+        g = AutopilotGuard(fg.port, every=0.05)
+        self.addCleanup(g.close)
+        g.next = time.monotonic() + 0.05   # not due on the first call
+        start = time.monotonic()
+        for _ in range(50):
+            g.check()
+            time.sleep(0.01)
+        self.assertLess(time.monotonic() - start, 1.5)   # inline: 8 gets x 0.4 s per poll
+
+    def test_background_poll_forces_autopilot_off_and_counts_it(self):
+        import time
+        fg, g = FakeFG({'/autopilot/internal/CMDA': '0'}), None
+        self.addCleanup(fg.server_close)
+        self.addCleanup(fg.shutdown)
+        g = AutopilotGuard(fg.port, every=0.05)
+        self.addCleanup(g.close)
+        g.check()
+        fg.props['/autopilot/internal/CMDA'] = '1'
+        deadline = time.monotonic() + 3
+        while not g.violations and time.monotonic() < deadline:
+            g.check()
+            time.sleep(0.02)
+        self.assertEqual(g.violations[0], ['/autopilot/internal/CMDA'])
+        self.assertEqual(fg.props['/autopilot/internal/CMDA'], '0')
+
+    def test_autopilot_that_wont_turn_off_still_stops_the_run(self):
+        import time
+        fg = FakeFG({'/autopilot/internal/CMDB': '0'}, sticky={'/autopilot/internal/CMDB'})
+        self.addCleanup(fg.server_close)
+        self.addCleanup(fg.shutdown)
+        g = AutopilotGuard(fg.port, every=0.05)
+        self.addCleanup(g.close)
+        g.check()
+        fg.props['/autopilot/internal/CMDB'] = '1'
+        deadline = time.monotonic() + 3
+        with self.assertRaisesRegex(AutopilotEngaged, 'could not be switched off'):
+            while time.monotonic() < deadline:
+                g.check()
+                time.sleep(0.02)
+
