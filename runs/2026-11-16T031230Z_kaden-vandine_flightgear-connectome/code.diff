     """The airplane autopilot is on while the fly is (or is about to be) flying."""
 
 
+class TelnetPoller:
+    """Runs a rule check's telnet polling in a background thread, off the flight loop.
+
+    FlightGear's telnet server answers slowly: 300-500 ms per round trip on the Linux
+    AppImage (2026-11-16), and seconds when the sim is busy. Polled inline, the
+    AutopilotGuard/SpeedLock checks blocked the control loop: on the Burbank approach
+    the loop stood still for ~10 s, the 737 flew on a frozen 0.24 aileron command, rolled
+    to 70 deg and hit the ground 2 km short of the runway.
+
+    The first plain check() starts the thread, which runs check(force=True) every
+    `every` seconds. Later plain check() calls never touch the socket: they re-raise
+    whatever the thread hit (AutopilotEngaged, a lost connection), so the run still stops
+    exactly as before. check(force=True) stays synchronous. A lock keeps the thread and a
+    forced check from using the socket at once."""
+
+    def _poll_init(self):
+        import threading
+        self._poll_lock = threading.RLock()
+        self._poll_thread = self._poll_error = None
+        self._poll_stop = threading.Event()
+
+    def _poll_start(self):
+        import threading
+        self._poll_thread = threading.Thread(target=self._poll_loop, daemon=True,
+                                             name=f'{type(self).__name__}-poll')
+        self._poll_thread.start()
+
+    def _poll_loop(self):
+        while not self._poll_stop.wait(max(0.0, self.next - time.monotonic())):
+            try:
+                self.check(force=True)
+            except Exception as exc:  # handed to the flight loop by the next check()
+                self._poll_error = exc
+                return
+
+    def _poll_check(self, force):
+        """Returns True if the caller should run its synchronous check."""
+        if force:
+            return True
+        if self._poll_thread is None:
+            # First call: a poll that is already due runs inline once (as before), then
+            # the thread takes over from the next interval.
+            if time.monotonic() >= self.next:
+                self.check(force=True)
+            self._poll_start()
+            return False
+        if self._poll_error is not None:
+            raise self._poll_error
+        return False
+
+    def _poll_close(self):
+        thread = self._poll_thread
+        if thread is not None:
+            self._poll_stop.set()
+            thread.join(timeout=5)
+
+
