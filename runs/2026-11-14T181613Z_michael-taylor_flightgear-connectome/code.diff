+                        vi = v[i]
+                        if i < ndriven:
+                            vi += DT * (V0 - vi + gi_) / TM
+                            gi_ *= decay
+                            for q in range(kick_ptr[i], kick_ptr[i + 1]):
+                                if rand[row + kick_off[q]] < kick_p[q]:
+                                    vi += KICK
+                        elif (t - last[i]) > REF:
+                            vi += DT * (V0 - vi + gi_) / TM
