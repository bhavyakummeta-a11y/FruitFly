<?xml version="1.0"?>
<!--
  FruitFly: Boeing 737-800 with fruit fly passengers.

  setup_aircraft.py copies this file into Aircraft/737-800/ (next to the stock
  738-set.xml). It has to live there: JSBSim loads the flight model from the
  directory of the -set file. Edit it here, not in the copy.

  Aircraft ID: 738-flies
-->
<PropertyList include="738-set.xml">
  <sim>
    <description>Boeing 737-800 + fruit fly passengers (FruitFly)</description>

    <model>
      <path>Aircraft/FlyCabin/Models/738-flies.xml</path>
    </model>

    <!-- view axes: x = right, y = up, z = back (metres) -->
    <view n="130">
      <name>Cabin: aisle, looking forward</name>
      <type>lookfrom</type>
      <internal archive="y">true</internal>
      <config>
        <from-model type="bool">true</from-model>
        <from-model-idx type="int">0</from-model-idx>
        <default-field-of-view-deg type="double">70</default-field-of-view-deg>
        <pitch-offset-deg>-10</pitch-offset-deg>
        <heading-offset-deg>0</heading-offset-deg>
        <x-offset-m archive="y">0.0</x-offset-m>
        <y-offset-m archive="y">1.60</y-offset-m>
        <z-offset-m archive="y">10.9</z-offset-m>
      </config>
    </view>
    <view n="131">
      <name>Cabin: front, facing the passengers</name>
      <type>lookfrom</type>
      <internal archive="y">true</internal>
      <config>
        <from-model type="bool">true</from-model>
        <from-model-idx type="int">0</from-model-idx>
        <default-field-of-view-deg type="double">70</default-field-of-view-deg>
        <pitch-offset-deg>-12</pitch-offset-deg>
        <heading-offset-deg>180</heading-offset-deg>
        <x-offset-m archive="y">0.0</x-offset-m>
        <y-offset-m archive="y">1.55</y-offset-m>
        <z-offset-m archive="y">-13.1</z-offset-m>
      </config>
    </view>
    <!-- The fly pilot at the controls, the panel and the windshield in one frame:
         just behind and right of the captain, looking forward-left at the fly and out the windshield. -->
    <view n="132">
      <name>Cockpit: fly pilot</name>
      <type>lookfrom</type>
      <internal archive="y">true</internal>
      <config>
        <from-model type="bool">true</from-model>
        <from-model-idx type="int">0</from-model-idx>
        <default-field-of-view-deg type="double">85</default-field-of-view-deg>
        <pitch-offset-deg>2</pitch-offset-deg>
        <heading-offset-deg>34</heading-offset-deg>
        <x-offset-m archive="y">0.15</x-offset-m>
        <y-offset-m archive="y">1.38</y-offset-m>
        <z-offset-m archive="y">-16.75</z-offset-m>
      </config>
    </view>
    <!-- Running gag: rides along the aisle with the fly flight attendant's snack cart
         (cabin_show.nas moves it with the cart), looking forward at her. -->
    <view n="133">
      <name>Cabin: follow the snack cart</name>
      <type>lookfrom</type>
      <internal archive="y">true</internal>
      <config>
        <from-model type="bool">true</from-model>
        <from-model-idx type="int">0</from-model-idx>
        <default-field-of-view-deg type="double">65</default-field-of-view-deg>
        <pitch-offset-deg>-14</pitch-offset-deg>
        <heading-offset-deg>0</heading-offset-deg>
        <x-offset-m archive="y">0.0</x-offset-m>
        <y-offset-m archive="y">1.60</y-offset-m>
        <z-offset-m archive="y">-10.5</z-offset-m>
      </config>
    </view>
  </sim>

  <fruitfly>
    <!-- Python bridge writes these over telnet/httpd -->
    <autostart type="bool">false</autostart>   <!-- set true: runs the 737's own autostart -->
    <!-- The fly pilot: the controller (the fly brain) writes active/power/steer/escape
         from descending-neuron rates; fruitfly.nas animates the rest. Display only. -->
    <pilot>
      <active type="bool">false</active>
      <power type="double">0</power>        <!-- 0..1  DNg02 (wingbeat amplitude) -->
      <steer type="double">0</steer>        <!-- -1..1 steering DNs, right minus left -->
      <escape type="double">0</escape>      <!-- 0..1  DNp01 Giant Fibre -->
      <start-view type="bool">true</start-view>  <!-- open in "Cockpit: fly pilot" -->
      <flap-norm type="double">0</flap-norm>
      <head-turn-deg type="double">0</head-turn-deg>
      <lean-deg type="double">0</lean-deg>
      <hop-m type="double">0</hop-m>
    </pilot>
    <passengers>
      <activity type="double">0.15</activity>  <!-- 0..1, e.g. a normalised firing rate -->
      <group n="0"><flap-norm type="double">0</flap-norm><head-turn-deg type="double">0</head-turn-deg></group>
      <group n="1"><flap-norm type="double">0</flap-norm><head-turn-deg type="double">0</head-turn-deg></group>
      <group n="2"><flap-norm type="double">0</flap-norm><head-turn-deg type="double">0</head-turn-deg></group>
    </passengers>
    <!-- The session log page's view buttons write a view name here (cabin_show.nas).
         Changes only what the viewer sees, never the fly pilot. -->
    <view-request type="string"></view-request>
    <!-- Running gag: the fly flight attendant (cabin_show.nas). Display only. -->
    <cabin>
      <attendant>
        <x-m type="double">-13.1</x-m>
        <bob-m type="double">0</bob-m>
        <turn-deg type="double">180</turn-deg>
        <stride-deg type="double">0</stride-deg>
        <flap-norm type="double">0</flap-norm>
        <serve-m type="double">0</serve-m>
        <item type="int">0</item>
      </attendant>
      <!-- Running gag: the crying baby, a fly larva (cabin_show.nas). Display only. -->
      <baby>
        <crying type="bool">true</crying>
        <wiggle-deg type="double">0</wiggle-deg>
        <tear-m type="double">0</tear-m>
      </baby>
    </cabin>
  </fruitfly>

  <nasal>
    <fruitfly>
      <file>Aircraft/FlyCabin/Nasal/fruitfly.nas</file>
    </fruitfly>
    <fruitfly_cabin>
      <file>Aircraft/FlyCabin/Nasal/cabin_rows.nas</file>
      <file>Aircraft/FlyCabin/Nasal/cabin_show.nas</file>
    </fruitfly_cabin>
  </nasal>
</PropertyList>
