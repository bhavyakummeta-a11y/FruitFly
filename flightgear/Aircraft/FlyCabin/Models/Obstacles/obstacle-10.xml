<?xml version="1.0"?>
<!-- Generated by flightgear/tools/make_obstacles.py; do not edit. Obstacle index 10. -->
<PropertyList>
  <path>tornado.ac</path>

  <animation>
    <type>select</type>
    <object-name>Dark</object-name><object-name>Mid</object-name><object-name>Cap</object-name><object-name>Debris</object-name><object-name>Bolt</object-name><object-name>Ring</object-name>
    <condition><property>/fruitfly/obstacles/obstacle[10]/visible</property></condition>
  </animation>

  <!-- Lightning bolt beside this tornado: only while storm.nas points at index 10. -->
  <animation>
    <type>select</type>
    <object-name>Bolt</object-name>
    <condition>
      <equals><property>/fruitfly/storm/bolt</property><value>10</value></equals>
    </condition>
  </animation>
  <animation>
    <type>material</type>
    <object-name>Bolt</object-name>
    <emission><red>1.0</red><green>1.0</green><blue>0.85</blue></emission>
  </animation>

  <!-- radius: x and y; height: z. Unit tornado, so scale = metres. -->
  <animation>
    <type>scale</type>
    <object-name>Dark</object-name><object-name>Mid</object-name><object-name>Cap</object-name><object-name>Debris</object-name><object-name>Bolt</object-name><object-name>Ring</object-name>
    <property>/fruitfly/obstacles/obstacle[10]/radius-m</property>
    <x-factor>1</x-factor><x-offset>0</x-offset>
    <y-factor>1</y-factor><y-offset>0</y-offset>
    <z-factor>0</z-factor><z-offset>1</z-offset>
  </animation>
  <animation>
    <type>scale</type>
    <object-name>Dark</object-name><object-name>Mid</object-name><object-name>Cap</object-name><object-name>Debris</object-name><object-name>Bolt</object-name>
    <property>/fruitfly/obstacles/obstacle[10]/height-m</property>
    <x-factor>0</x-factor><x-offset>1</x-offset>
    <y-factor>0</y-factor><y-offset>1</y-offset>
    <z-factor>1</z-factor><z-offset>0</z-offset>
  </animation>

  <!-- The funnel turns with sim time (it stops when the sim is paused). -->
  <animation>
    <type>rotate</type>
    <object-name>Dark</object-name><object-name>Mid</object-name><object-name>Debris</object-name>
    <property>/sim/time/elapsed-sec</property>
    <factor>50</factor>
    <center><x-m>0</x-m><y-m>0</y-m><z-m>0</z-m></center>
    <axis><x>0</x><y>0</y><z>1</z></axis>
  </animation>

  <!-- Pale glow while the fly's looming input comes from this obstacle. -->
  <animation>
    <type>material</type>
    <object-name>Dark</object-name><object-name>Mid</object-name>
    <emission>
      <factor-prop>/fruitfly/obstacles/obstacle[10]/threat</factor-prop>
      <red>0.55</red><green>0.65</green><blue>0.95</blue>
    </emission>
  </animation>
</PropertyList>
