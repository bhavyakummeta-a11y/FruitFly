# FruitFly cabin show: a running gag for whoever looks into the cabin.
#
# A fly flight attendant pushes a snack cart down the aisle, stops at every row and
# hands each side a cup of water, a swirl of poop or a slice of rotten banana. Then she
# pulls the cart back to the front galley and starts again. She has no brain; this
# script is all there is. DISPLAY ONLY: nothing here touches the flight controls or the
# fly pilot.
#
# Loaded with cabin_rows.nas (generated by flightgear/tools/make_cabin.py: ROWS,
# START_X, SERVE_OFFSET) in the fruitfly_cabin Nasal module.
#
# Outputs (attendant.xml animations), under /fruitfly/cabin/attendant/:
#   x-m, bob-m, turn-deg, stride-deg, flap-norm, serve-m, item (0 none, 1 water,
#   2 poop, 3 rotten banana)
# Counters: /fruitfly/cabin/served/{water,poop,banana}
#
# Also here (display only):
#   /fruitfly/view-request (string)  set by the session log page's view buttons: the
#       name of a view to switch to. Cleared once handled.
#   "Cabin: follow the snack cart" view: the camera rides along the aisle with the cart.
#   The crying baby (bottom of this file): /fruitfly/cabin/baby/{crying,wiggle-deg,tear-m},
#   and Sounds/baby-cry.wav while you watch from a cabin view.

var att = props.globals.getNode("/fruitfly/cabin/attendant", 1);
var served = props.globals.getNode("/fruitfly/cabin/served", 1);
var ITEM_NAMES = ["", "water", "poop", "banana"];
foreach (var k; ["water", "poop", "banana"]) served.getNode(k, 1).setIntValue(0);

var DT = 0.04;
var SERVE_SPEED = 0.55;    # m/s between rows
var RETURN_SPEED = 0.9;    # m/s pulling the empty-ish cart back to the galley
var FACE_REAR = 180;       # she faces the tail while serving, cart in front of her
var FACE_FRONT = 0;

var x = START_X;
var turn = FACE_REAR;
var t = 0.0;

# A show is a queue of steps; each step is a func(dt) that returns 1 when it is done.
var queue = [];
var walk_to = func(target, speed) {
    return func(dt) {
        var d = target - x;
        var step = speed * dt;
        var moving = math.abs(d) > step;
        x = moving ? x + (d > 0 ? step : -step) : target;
        var gait = math.sin(2 * math.pi * 1.6 * t);
        att.setDoubleValue("stride-deg", moving ? 18 * gait : 0);
        att.setDoubleValue("bob-m", moving ? 0.02 * math.abs(gait) : 0);
        return !moving;
    };
};
var turn_to = func(target) {
    return func(dt) {
        var d = target - turn;
        var step = 240 * dt;    # deg/s
        if (math.abs(d) <= step) { turn = target; return 1; }
        turn += d > 0 ? step : -step;
        return 0;
    };
};
var wait = func(seconds) {
    var left = seconds;
    return func(dt) { left -= dt; return left <= 0; };
};
var hand_out = func {
    var item = 0;
    var s = 0.0;
    var phase = 0;    # 0 pick, 1 reach out, 2 hold, 3 let go
    var hold = 0.0;
    return func(dt) {
        if (phase == 0) {
            var r = rand();
            item = r < 0.5 ? 1 : (r < 0.85 ? 2 : 3);
            att.setIntValue("item", item);
            phase = 1;
        } elsif (phase == 1) {
            s += 1.4 * dt;
            att.setDoubleValue("flap-norm", 0.4 + 0.4 * math.sin(2 * math.pi * 6 * t));
            if (s >= 0.7) { s = 0.7; phase = 2; hold = 0.4; }
        } elsif (phase == 2) {
            hold -= dt;
            if (hold <= 0) phase = 3;
        } else {
            # the passenger takes it: the item vanishes, her hands come back empty
            att.setIntValue("item", 0);
            att.setDoubleValue("flap-norm", 0);
            var n = served.getNode(ITEM_NAMES[item], 1);
            n.setIntValue((n.getValue() or 0) + 1);
            s = 0;
            att.setDoubleValue("serve-m", 0);
            return 1;
        }
        att.setDoubleValue("serve-m", s);
        return 0;
    };
};

var plan = func {
    foreach (var row; ROWS) {
        append(queue, walk_to(row + SERVE_OFFSET, SERVE_SPEED));
        append(queue, turn_to(FACE_REAR - 90));
        append(queue, hand_out());
        append(queue, turn_to(FACE_REAR + 90));
        append(queue, hand_out());
        append(queue, turn_to(FACE_REAR));
    }
    append(queue, wait(1.5));
    append(queue, turn_to(FACE_FRONT));
    append(queue, walk_to(START_X, RETURN_SPEED));
    append(queue, turn_to(FACE_REAR));
    append(queue, wait(4));
};

var follow_view = 0;
var update = func {
    t += DT;
    if (!size(queue)) plan();
    if (queue[0](DT)) queue = subvec(queue, 1);
    att.setDoubleValue("x-m", x);
    att.setDoubleValue("turn-deg", turn);
    if (follow_view)
        setprop("/sim/current-view/z-offset-m", x + 2.6);   # view z = model x (back)
};
att.setIntValue("item", 0);
att.setDoubleValue("serve-m", 0);
var timer = maketimer(DT, update);
timer.start();

# ---- views -------------------------------------------------------------------
var view_name = func {
    var n = getprop("/sim/current-view/view-number");
    if (n == nil or view.views == nil or n < 0 or n >= size(view.views)) return "";
    return view.views[n].getNode("name", 1).getValue() or "";
};
setlistener("/sim/current-view/view-number", func {
    follow_view = view_name() == "Cabin: follow the snack cart";
}, 1, 0);

# The session log page's view buttons write a view name here. Changes only what the
# person watching sees; the fly pilot doesn't use the camera.
setlistener("/fruitfly/view-request", func(n) {
    var name = n.getValue() or "";
    if (name == "") return;
    var i = view.indexof(name);
    if (i != nil and i >= 0) {
        setprop("/sim/current-view/view-number", i);
        print("FruitFly: view -> " ~ name);
    } else {
        print("FruitFly: no view named '" ~ name ~ "'");
    }
    n.setValue("");
}, 0, 0);

# ---- the crying baby -----------------------------------------------------------
# A fly larva on a parent's lap (row BABY_ROW_X, left aisle seat). It cries in fits,
# wriggling with tears and an open mouth, and you hear it (Sounds/baby-cry.wav) only
# in the cabin views. When the flight attendant serves its row it gets a pacifier and
# goes quiet for a while, then starts again.
var baby = props.globals.getNode("/fruitfly/cabin/baby", 1);
var CRY_FILE = "baby-cry.wav";
var CRY_LEN = 4.5;                 # seconds, the sample's length
var cry_path = nil;
var full = resolvepath("Aircraft/FlyCabin/Sounds/" ~ CRY_FILE);
if (full != nil and full != "") {
    var cut = size(full) - size(CRY_FILE);
    cry_path = substr(full, 0, cut);
} else {
    print("FruitFly: Sounds/" ~ CRY_FILE ~ " not found - the baby cries silently");
}
var crying = 1;
var mood_left = 25.0;              # seconds until the next change of mood
var next_sob = 0.0;
var bt = 0.0;
var in_cabin = func { var n = view_name(); return size(n) >= 6 and substr(n, 0, 6) == "Cabin:"; };
var update_baby = func {
    bt += DT;
    mood_left -= DT;
    # the cart reaching the baby's row: pacifier, peace and quiet for a while
    if (crying and math.abs(x - BABY_ROW_X) < 0.3 and att.getValue("item")) {
        crying = 0;
        mood_left = 20 + 15 * rand();
    } elsif (mood_left <= 0) {
        crying = !crying;
        mood_left = crying ? 20 + 25 * rand() : 8 + 10 * rand();
    }
    baby.setBoolValue("crying", crying);
    baby.setDoubleValue("wiggle-deg", crying ? 14 * math.sin(2 * math.pi * 2.2 * bt) * math.sin(0.7 * bt)
                                             : 2 * math.sin(0.8 * bt));
    baby.setDoubleValue("tear-m", crying ? math.mod(bt * 0.12, 0.10) : 0);
    if (crying and cry_path != nil and bt >= next_sob and in_cabin()) {
        var loud = view_name() == "Cabin: follow the snack cart" ? 0.8 : 0.6;
        fgcommand("play-audio-sample", props.Node.new({path: cry_path, file: CRY_FILE,
                                                        volume: loud, queue: "fruitfly-baby"}));
        next_sob = bt + CRY_LEN;
    }
};
var baby_timer = maketimer(DT, update_baby);
baby_timer.start();

print("FruitFly: cabin show loaded (flight attendant on duty, baby crying)");
