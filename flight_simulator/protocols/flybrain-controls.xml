<?xml version='1.0' encoding='utf-8'?>
<PropertyList>
  <generic>
    <input>
      <binary_mode>false</binary_mode>
      <line_separator>newline</line_separator>
      <var_separator>,</var_separator>
      <chunk>
        <name>aileron</name>
        <node>/controls/flight/aileron</node>
        <type>float</type>
        <min>-1</min>
        <max>1</max>
      </chunk>
      <chunk>
        <name>elevator</name>
        <node>/controls/flight/elevator</node>
        <type>float</type>
        <min>-1</min>
        <max>1</max>
      </chunk>
      <chunk>
        <name>rudder</name>
        <node>/controls/flight/rudder</node>
        <type>float</type>
        <min>-1</min>
        <max>1</max>
      </chunk>
      <chunk>
        <name>throttle</name>
        <node>/controls/engines/engine[0]/throttle</node>
        <type>float</type>
        <min>0</min>
        <max>1</max>
      </chunk>
      <chunk>
        <name>frozen</name>
        <node>/sim/freeze/clock</node>
        <type>bool</type>
      </chunk>
    </input>
  </generic>
