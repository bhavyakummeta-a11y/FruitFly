<?xml version='1.0' encoding='utf-8'?>
<!-- Runway (takeoff/landing) protocol for flight_simulator.takeoff_landing. Field order is the wire format. -->
<PropertyList>
  <generic>
    <input>
      <binary_mode>false</binary_mode>
      <line_separator>newline</line_separator>
      <var_separator>,</var_separator>
      <chunk>
        <name>aileron</name>
        <node>/controls/flight/aileron</node>
        <type>float</type>
        <min>-1</min>
        <max>1</max>
      </chunk>
      <chunk>
        <name>elevator</name>
        <node>/controls/flight/elevator</node>
        <type>float</type>
        <min>-1</min>
        <max>1</max>
      </chunk>
      <chunk>
        <name>rudder</name>
        <node>/controls/flight/rudder</node>
        <type>float</type>
        <min>-1</min>
        <max>1</max>
      </chunk>
      <chunk>
        <name>throttle0</name>
        <node>/controls/engines/engine[0]/throttle</node>
        <type>float</type>
        <min>0</min>
        <max>1</max>
      </chunk>
      <chunk>
        <name>throttle1</name>
        <node>/controls/engines/engine[1]/throttle</node>
        <type>float</type>
        <min>0</min>
        <max>1</max>
      </chunk>
      <chunk>
        <name>brake_left</name>
        <node>/controls/gear/brake-left</node>
        <type>float</type>
        <min>0</min>
        <max>1</max>
      </chunk>
      <chunk>
        <name>brake_right</name>
        <node>/controls/gear/brake-right</node>
        <type>float</type>
        <min>0</min>
        <max>1</max>
      </chunk>
      <chunk>
        <name>gear_down</name>
        <node>/controls/gear/gear-down</node>
        <type>bool</type>
      </chunk>
      <chunk>
        <name>frozen</name>
        <node>/sim/freeze/master</node>
        <type>bool</type>
      </chunk>
    </input>
  </generic>
</PropertyList>
