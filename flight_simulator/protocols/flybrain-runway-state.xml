<?xml version='1.0' encoding='utf-8'?>
<!-- Runway (takeoff/landing) protocol for flight_simulator.takeoff_landing. Field order is the wire format. -->
<PropertyList>
  <generic>
    <output>
      <binary_mode>false</binary_mode>
      <line_separator>newline</line_separator>
      <var_separator>,</var_separator>
      <chunk>
        <name>elapsed</name>
        <node>/sim/time/elapsed-sec</node>
        <type>float</type>
        <format>%.8f</format>
      </chunk>
      <chunk>
        <name>latitude</name>
        <node>/position/latitude-deg</node>
        <type>float</type>
        <format>%.8f</format>
      </chunk>
      <chunk>
        <name>longitude</name>
        <node>/position/longitude-deg</node>
        <type>float</type>
        <format>%.8f</format>
      </chunk>
      <chunk>
        <name>agl</name>
        <node>/position/altitude-agl-ft</node>
        <type>float</type>
        <format>%.8f</format>
      </chunk>
      <chunk>
        <name>heading</name>
        <node>/orientation/heading-deg</node>
        <type>float</type>
        <format>%.8f</format>
      </chunk>
      <chunk>
        <name>roll</name>
        <node>/orientation/roll-deg</node>
        <type>float</type>
        <format>%.8f</format>
      </chunk>
      <chunk>
        <name>pitch</name>
        <node>/orientation/pitch-deg</node>
        <type>float</type>
        <format>%.8f</format>
      </chunk>
      <chunk>
        <name>airspeed</name>
        <node>/velocities/airspeed-kt</node>
        <type>float</type>
        <format>%.8f</format>
      </chunk>
      <chunk>
        <name>climb</name>
        <node>/velocities/vertical-speed-fps</node>
        <type>float</type>
        <format>%.8f</format>
      </chunk>
      <chunk>
        <name>wow</name>
        <node>/gear/gear[1]/wow</node>
        <type>bool</type>
        <format>%d</format>
      </chunk>
      <chunk>
        <name>frozen</name>
        <node>/sim/freeze/master</node>
        <type>bool</type>
        <format>%d</format>
      </chunk>
    </output>
  </generic>
</PropertyList>
